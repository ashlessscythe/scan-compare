# ── App ──────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_NAME="Tesla Scan Verification"
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Auth.js ──────────────────────────────────────────
# Generate: openssl rand -base64 32
AUTH_SECRET=your-auth-secret-here-min-32-chars
AUTH_URL=http://localhost:3000
# Production (Vercel/Koyeb/Render): set to your deployed URL
# AUTH_URL=https://your-app.vercel.app

# ── Neon PostgreSQL ────────────────────────────────────
# Pooled connection — use for app runtime (Prisma Client)
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15

# Direct connection — use for Prisma Migrate / db push / seed only
DIRECT_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# ── Local dev (docker-compose) ───────────────────────
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/label_verification
# DIRECT_URL=postgresql://postgres:postgres@localhost:5432/label_verification

# ── Email (Resend recommended) ───────────────────────
# Used for shipment report emails, password-reset links, and welcome/approval emails.
# From-address comes from each site's App Settings in the admin UI.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Password-reset emails use NEXT_PUBLIC_APP_URL for the link target.
# Fallback SMTP (optional, if not using Resend)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_FROM=no-reply@yourdomain.com

# ── Seed overrides (optional) ────────────────────────
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin123!
SEED_OPERATOR_EMAIL=operator@example.com
SEED_OPERATOR_PASSWORD=Operator123!
